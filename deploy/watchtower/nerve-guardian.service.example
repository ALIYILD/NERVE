[Unit]
Description=Independent NERVE Guardian (review and provision before installation)
After=network.target
ConditionPathExists=/etc/nerve-guardian/ENABLED

[Service]
# Separate immutable installation; sample config remains observe-only.
Type=simple
Environment=PYTHONPATH=/opt/nerve-safety/safety
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/nerve-safety/.venv/bin/python -m nerve_guardian service --config /etc/nerve-guardian/config.json
Restart=on-failure
RestartSec=5
User=root
Group=root
StateDirectory=nerve-guardian
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nerve-guardian /etc/systemd/system /run/systemd
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=60
# No Install section: never enabled by copying this example.
