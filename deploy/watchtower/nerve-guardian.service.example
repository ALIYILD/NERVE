[Unit]
Description=Independent NERVE Guardian (review and provision before installation)
After=network.target
ConditionPathExists=/etc/nerve-guardian/ENABLED

[Service]
# The core service entrypoint must be supplied by the reviewed deployment.
# This deliberately cannot activate a controller or invent an executable.
Type=oneshot
ExecStart=/usr/bin/false
User=root
Group=root
StateDirectory=nerve-guardian
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nerve-guardian /etc/systemd/system /run/systemd
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=60
# No Install section: never enabled by copying this example.
